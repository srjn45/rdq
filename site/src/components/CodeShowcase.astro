---
const { side = 'left', title = '', blurb = '', code = '', href = '', hrefLabel = 'Read the guide →' } = Astro.props;
const base = import.meta.env.BASE_URL;
const rowDir = side === 'right' ? 'row-reverse' : 'row';
---
<section class="section">
  <div class="wrap" style={`display:flex;flex-direction:${rowDir};gap:26px;align-items:center;flex-wrap:wrap`}>
    <pre class="mono" style="flex:1 1 380px;min-width:300px;margin:0;background:#010409;border:1px solid var(--border);border-radius:8px;padding:16px;overflow:auto;font-size:0.86rem;line-height:1.55"><code>{code}</code></pre>
    <div style="flex:1 1 260px">
      <h2 style="margin-top:0">{title}</h2>
      <p style="color:var(--muted);font-size:1.08rem" set:html={blurb}></p>
      {href && <a href={`${base}${href}`}>{hrefLabel}</a>}
    </div>
  </div>
</section>
